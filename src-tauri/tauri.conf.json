{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rmemo",
  "version": "1.0.4",
  "identifier": "io.github.hirosugu415.rmemo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1440",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rmemo",
        "width": 640,
        "height": 560,
        "minWidth": 420,
        "minHeight": 320,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --renderer-process-limit=1 --js-flags=--max-old-space-size=64",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "hirosugu415",
    "copyright": "© 2026 hirosugu415",
    "license": "MIT",
    "homepage": "https://hirosugu415.github.io/Rmemo/",
    "category": "Productivity",
    "shortDescription": "ホットキーひとつで書きとめる、Windows 用のすばやいメモアプリ",
    "longDescription": "Rmemo は、思いついた瞬間にホットキーで呼び出して書きとめるメモアプリです。メモは Markdown のテキストファイルとして保存されます。",
    "windows": {
      "nsis": {
        "languages": [
          "Japanese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg1QjU2MkU1QjdBQzYzOTUKUldTVlk2eTM1V0sxaGJ5SmFCVWFSS0ZCOHYvNzhsRHdubnJsVHdUUy96NUpSZEdxaGJNZGJQWVkK",
      "endpoints": [
        "https://github.com/hirosugu415/Rmemo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
